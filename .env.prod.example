# docker-compose.prod.yml 이 읽는 운영 환경변수 목록.
# 이 파일은 "이름만" 있는 예시다. 실제 값은 넣지 않는다.
#
# EC2 에서:
#   cp .env.prod.example .env && chmod 600 .env && vi .env
# .env 는 Git 에 올라가지 않는다(.gitignore).

# --- PostgreSQL ------------------------------------------------------------
# DB 이름은 haruleaf 로 고정한다. 기존 서비스(app-db), CareLog DB 와 완전히 별개다.
POSTGRES_DB=haruleaf
# 기존 서비스 계정을 재사용하지 않는다. HaruLeaf 전용 계정을 새로 만든다(영문 소문자·숫자·_).
POSTGRES_USER=
# 생성해서 넣는다:  openssl rand -hex 32
# 접속 주소(URL)에 그대로 들어가므로 base64(+ / = 포함) 말고 hex 로 만든다.
POSTGRES_PASSWORD=

# --- 인증 ------------------------------------------------------------------
# 따로 넣을 키가 없다. JWT 를 쓰지 않고, 로그인 때 무작위 세션 토큰을 발급해
# DB(sessions)에 해시로 저장한다(30일 유지). 서명용 secret 이 필요 없다.

# --- 호스트 포트 -----------------------------------------------------------
# 사용 중인 22 / 80 / 443 / 5432 / 8000 / 8081 과 겹치면 안 된다.
# PostgreSQL 은 호스트 포트를 쓰지 않는다. 그래서 여기에 항목이 없다.
HARULEAF_BACKEND_HOST_PORT=4000

# --- 앱 설정 ---------------------------------------------------------------
# Web 화면을 배포하면 그 주소를 넣는다(여러 개면 쉼표로 구분). 예: http://<EC2 주소>:<웹 포트>
# iOS 앱은 CORS 를 쓰지 않으므로, Web 을 아직 안 올렸으면 비워 둔다.
HARULEAF_CORS_ORIGINS=
# 출석 1회 지급 코인. 비우면 5.
HARULEAF_ATTENDANCE_COINS=5

# --- 기타 ------------------------------------------------------------------
# 이미지 태그. 롤백할 때 이전 태그로 바꿔 다시 up -d 한다.
HARULEAF_IMAGE_TAG=latest
