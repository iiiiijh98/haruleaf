# 앱(apps/app)이 읽는 환경변수 목록. 실제 값은 apps/app/.env 에 넣는다(.gitignore 대상).
#   cp apps/app/.env.example apps/app/.env && vi apps/app/.env
#
# EXPO_PUBLIC_ 로 시작하는 값은 앱 번들에 그대로 들어가 누구나 볼 수 있다.
# 비밀번호·키 같은 비밀값은 절대 넣지 않는다(앱에는 비밀값이 필요 없다).

# --- API 서버 주소 -----------------------------------------------------------
# 앱이 호출할 HaruLeaf API 서버. 끝에 / 를 붙이지 않는다.
#   운영 : https://haruleaf.iliasai.com  (apps/app/.env.production 에 들어 있어 운영 빌드가 자동으로 읽는다)
#   맥북 개발 : 이 줄을 지우면 http://localhost:4000 (빈 값 `EXPO_PUBLIC_API_URL=` 은 쓰지 않는다)
# 주의: `npm run dev` 는 이 값을 맥북 LAN 주소로 덮어쓴다(개발 전용).
#       EC2 서버에 붙여 보려면 `npm run dev:app` 으로 앱만 실행한다.
EXPO_PUBLIC_API_URL=https://haruleaf.iliasai.com
